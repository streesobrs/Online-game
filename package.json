{
  "name": "multi-game-server",
  "version": "1.6.0",
  "description": "多棋种联机大厅",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "pkg": "pkg . --targets node18-win-x64 --output dist/game-server.exe"
  },
  "bin": "server/server.js",
  "pkg": {
    "assets": [
      "server/modules/**/*",
      "server/utils/**/*",
      "server/config/**/*",
      "server/assets/**/*",
      "server/admin.html",
      "server/config.js",
      "server/server.js",
      "server/version.json",
      "client/**/*"
    ],
    "scripts": [
      "server/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.7.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}
