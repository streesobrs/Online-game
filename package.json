{
  "name": "multi-game-server",
  "version": "1.0.0",
  "description": "多棋种联机大厅",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "pkg": "pkg . --targets node18-win-x64 --output dist/game-server.exe"
  },
  "bin": "server/server.js",
  "pkg": {
    "assets": [
      "server/**/*",
      "index.html"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  }
}
