{
  "id": "cyberpunk",
  "name": "赛博朋克",
  "description": "赛博朋克风格主题，带有霓虹效果和未来感",
  "background": "radial-gradient(circle at 20% 50%, rgba(0, 212, 255, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255, 0, 255, 0.1) 0%, transparent 50%), #1e0030",
  "primaryColor": "#00d4ff",
  "secondaryColor": "#ff00ff",
  "accentColor": "#ff1493",
  "images": {
    "background": "/server/assets/lucy.png"
  },
  "effects": {
    "global": {
      "textShadow": "0 0 5px #00d4ff, 0 0 10px #00d4ff, 0 0 15px #ff00ff",
      "buttonShadow": "0 0 10px #00d4ff, 0 0 20px #ff00ff, inset 0 0 10px rgba(255, 255, 255, 0.1)",
      "buttonBorder": "1px solid #00d4ff"
    },
    "board": {
      "className": "cyberpunk-gobang",
      "glowEffect": true,
      "glowStyle": {
        "background": "radial-gradient(circle at 20% 50%, rgba(0, 212, 255, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(255, 0, 255, 0.1) 0%, transparent 50%)",
        "opacity": 0.2
      },
      "style": {
        "border": "2px solid #00d4ff",
        "boxShadow": "0 0 20px rgba(0, 212, 255, 0.7), 0 0 40px rgba(255, 0, 255, 0.6)",
        "animation": "neon-pulse 2.4s ease-in-out infinite"
      }
    },
    "pieces": {
      "shadow": "0 0 15px #ff1493, 0 0 30px #ff1493, 0 0 45px #ff1493, inset 0 0 10px rgba(255, 105, 180, 0.5)",
      "shadowWhite": "0 0 15px #ff1493, 0 0 30px #ff1493, 0 0 45px #ff69b4, inset 0 0 10px rgba(255, 105, 180, 0.5)",
      "filter": "brightness(1.4) saturate(1.3)",
      "black": {
        "background": "radial-gradient(circle at 30% 30%, #2a2a2a, #000)",
        "boxShadow": "0 0 15px #ff1493, 0 0 30px #ff1493, 0 0 45px #ff1493, inset 0 0 10px rgba(255, 105, 180, 0.5)",
        "filter": "brightness(1.4) saturate(1.3)"
      },
      "white": {
        "background": "radial-gradient(circle at 30% 30%, #fff, #e0e0e0)",
        "boxShadow": "0 0 15px #ff1493, 0 0 30px #ff1493, 0 0 45px #ff69b4, inset 0 0 10px rgba(255, 105, 180, 0.5)",
        "filter": "brightness(1.4) saturate(1.3)"
      },
      "selected": {
        "boxShadow": "0 0 25px #00d4ff, 0 0 50px #00d4ff, 0 0 75px #00d4ff, inset 0 0 15px rgba(0, 212, 255, 0.8)"
      }
    },
    "cells": {
      "background": "rgba(255, 20, 147, 0.15)",
      "boxShadow": "inset 0 0 10px rgba(255, 20, 147, 0.3)",
      "hover": {
        "background": "rgba(0, 255, 255, 0.4)",
        "boxShadow": "0 0 15px rgba(0, 255, 255, 0.8), inset 0 0 8px rgba(0, 255, 255, 0.5)"
      },
      "lastMove": {
        "background": "rgba(255, 0, 255, 0.5)",
        "boxShadow": "0 0 20px rgba(255, 0, 255, 0.9), inset 0 0 10px rgba(255, 0, 255, 0.6)"
      }
    },
    "animations": {
      "neonPulse": {
        "keyframes": [
          {
            "opacity": "1",
            "boxShadow": "0 0 20px rgba(0, 212, 255, 0.7), 0 0 40px rgba(255, 0, 255, 0.6)"
          },
          {
            "opacity": "0.8",
            "boxShadow": "0 0 30px rgba(0, 212, 255, 0.9), 0 0 60px rgba(255, 0, 255, 0.8)"
          },
          {
            "opacity": "1",
            "boxShadow": "0 0 20px rgba(0, 212, 255, 0.7), 0 0 40px rgba(255, 0, 255, 0.6)"
          }
        ],
        "duration": "2.4s",
        "timingFunction": "ease-in-out",
        "iterationCount": "infinite"
      }
    }
  },
  "panels": [
    {
      "id": "lucy",
      "enabled": true,
      "type": "character",
      "title": "Lucy",
      "description": "夜之城边缘行者",
      "image": "/server/assets/lucy.png",
      "position": {
        "right": "40px",
        "bottom": "80px",
        "width": "220px"
      },
      "style": {
        "background": "linear-gradient(145deg, rgba(10, 10, 26, 0.95), rgba(25, 25, 70, 0.95))",
        "boxShadow": "0 0 18px rgba(0, 212, 255, 0.6), 0 0 32px rgba(255, 0, 255, 0.4)",
        "border": "1px solid rgba(0, 212, 255, 0.8)",
        "backdropFilter": "blur(10px)",
        "avatarBorder": "2px solid rgba(0, 212, 255, 0.8)",
        "avatarShadow": "0 0 15px rgba(0, 212, 255, 0.6)",
        "nameColor": "#00d4ff",
        "nameTextShadow": "0 0 8px rgba(0, 212, 255, 0.8)",
        "descColor": "#cbd5f5"
      }
    }
  ],
  "boardBackground": {
