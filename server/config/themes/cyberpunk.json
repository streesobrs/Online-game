    "gobangWhite": "#fff",
    "goBlack": "#000",
    "goWhite": "#fff",
    "chessRed": "#ff1493",
    "chessBlack": "#00d4ff"
  },
  "uiColors": {
    "containerBg": "rgba(30, 0, 48, 0.8)",
    "titleColor": "#00d4ff",
    "statusColor": "#ffffff",
    "statusBg": "rgba(0, 212, 255, 0.1)",
    "usersBg": "rgba(30, 0, 48, 0.6)",
    "usersTitleColor": "#00d4ff",
    "userItemBg": "rgba(0, 212, 255, 0.2)",
    "userItemColor": "#ffffff",
    "leaderboardBg": "rgba(30, 0, 48, 0.6)",
    "leaderboardTitleColor": "#00d4ff",
    "leaderboardItemBg": "rgba(30, 0, 48, 0.8)",
    "rankColor": "#ffffff",
    "nameColor": "#00d4ff",
    "levelColor": "#ff00ff",
    "winsColor": "#00ff00",
    "winrateColor": "#ffff00",
    "buttons": {
      "active": {
        "background": "#00d4ff",
